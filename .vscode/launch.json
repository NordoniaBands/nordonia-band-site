{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Hugo: Serve & Open Browser",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "hugo",
      "runtimeArgs": ["server", "-D", "--navigateToChanged"],
      "console": "integratedTerminal",
      "serverReadyAction": {
        "pattern": "Web Server is available at (http://localhost:\\d+/)",
        "uriFormat": "%s",
        "action": "openExternally"
      }
    }
  ]
}
